      "type": "timeseries",
      "targets": [{"expr": "histogram_quantile(0.95, sum(rate(sprintsmith_project_http_request_duration_seconds_bucket{project_id=\"$project_id\"}[5m])) by (le))", "legendFormat": "p95"}]
