# Copy to /opt/sprintsmith/.env on the backend VM. Never commit the filled file.
POSTGRES_DB=sprintsmith
POSTGRES_USER=sprintsmith
POSTGRES_PASSWORD=replace-with-a-long-random-password
BACKEND_DATABASE_URL=postgresql+psycopg://sprintsmith:replace-with-a-long-random-password@db:5432/sprintsmith
AI_DATABASE_URL=postgresql+psycopg://sprintsmith:replace-with-a-long-random-password@db:5432/sprintsmith
BACKEND_IMAGE=ghcr.io/devansh-12/sprintsmith-backend-core:main
AI_ENGINE_IMAGE=ghcr.io/devansh-12/sprintsmith-ai-engine:main
JWT_SECRET_KEY=replace-with-a-long-random-secret
CORS_ORIGINS=https://app.rajmathuria.me
GROQ_API_KEY=
GOOGLE_API_KEY=
DEFAULT_LLM=groq-openai/gpt-oss-120b
FALLBACK_LLM=gemini-3.6-flash
RETRIEVAL_MODE=hybrid
LOG_LEVEL=INFO