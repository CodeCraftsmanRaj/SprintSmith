# Grafana is reachable two ways. The subpath route needs no DNS record and
# uses the already-working API hostname, so it is the default.

sprintsmith-api.rajmathuria.me {
	encode zstd gzip

	handle /grafana/* {
		reverse_proxy grafana:3000
	}

	handle /grafana {
		redir /grafana/ permanent
	}

	handle {
		reverse_proxy backend-core:8000
	}
}

# Optional dedicated hostname: add an A record grafana -> the VM static IP,
# then set GRAFANA_ROOT_URL=https://grafana.rajmathuria.me/ and
# GRAFANA_SERVE_FROM_SUB_PATH=false in /opt/sprintsmith/.env.
grafana.rajmathuria.me {
	encode zstd gzip
	reverse_proxy grafana:3000
}
