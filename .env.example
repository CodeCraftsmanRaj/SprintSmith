# Copy this file to .env locally. Never commit .env or paste real credentials here.

SPRINTSMITH_ENVIRONMENT=local
SPRINTSMITH_LOG_LEVEL=INFO
SPRINTSMITH_DATABASE_URL=postgresql://sprintsmith:sprintsmith@localhost:5433/sprintsmith
SPRINTSMITH_UPLOAD_DIR=./data/uploads

# Optional hosted inference credentials. Rotate any credentials exposed in chat
# before setting them locally. Leave empty for the local/no-provider baseline.
SPRINTSMITH_GROQ_API_KEY=
SPRINTSMITH_GOOGLE_API_KEY=
SPRINTSMITH_DEFAULT_LLM=local
SPRINTSMITH_FALLBACK_LLM=local

# Legacy names are also accepted for compatibility:
# DATABASE_URL=
# GROQ_API_KEY=
# GOOGLE_API_KEY=
# DEFAULT_LLM=
# FALLBACK_LLM=